l name="SQL 1*">INSERT INTO Fish (Name, Description, Rarity, AssetPath, MinWeight, MaxWeight, TopSpeed, HookedFuncNum, IsDiscovered) VALUES
('Humphead wrasse', 'The Humphead Wrasse is a large, colorful fish found in coral reefs, known for its distinct hump on its head and vibrant colors.', 'Epic', 'Art/Sprites/Fish/148', 2.0, 12.0, 6, 1, 0),
('Antarctic butterfish', 'The Antarctic Butterfish is a small, pale fish found in cold Antarctic waters, known for its soft texture and delicate flavor.', 'Rare', 'Art/Sprites/Fish/149', 0.2, 1.5, 3, 1, 0),
('Australian salmon', 'The Australian Salmon is a fast-swimming species found in southern Australian waters, prized by sport anglers for its fighting ability.', 'Rare', 'Art/Sprites/Fish/150', 1.0, 5.0, 8, 1, 0),
('Silver gemfish', 'The Silver Gemfish is a deep-sea predator found in cold waters, known for its shiny scales and sharp teeth.', 'Rare', 'Art/Sprites/Fish/151', 1.0, 3.5, 7, 1, 0),
('Blue maomao', 'The Blue Maomao is a small, schooling fish found in the waters of New Zealand, known for its vivid blue color and group behavior.', 'Uncommon', 'Art/Sprites/Fish/152', 0.1, 0.5, 5, 1, 0),
('Rabbitfish', 'The Rabbitfish is a herbivorous species found in tropical reefs, known for its rabbit-like face and spiny fins.', 'Uncommon', 'Art/Sprites/Fish/153', 0.2, 1.0, 4, 1, 0),
('Deepsea snailfish', 'The Deepsea Snailfish is a bottom-dwelling species found in deep ocean waters, known for its ability to withstand extreme depths.', 'Rare', 'Art/Sprites/Fish/154', 0.1, 1.0, 2, 1, 0),
('Glacial flounder', 'The Glacial Flounder is a flatfish found in Arctic waters, known for its ability to blend in with the ocean floor.', 'Rare', 'Art/Sprites/Fish/155', 0.5, 2.5, 3, 1, 0),
('Polar cod', 'The Polar Cod is a small fish found in the cold waters of the Arctic, known for its resilience to freezing temperatures.', 'Common', 'Art/Sprites/Fish/156', 0.1, 1.0, 2, 1, 0),
('Antarctic toothfish', 'The Antarctic Toothfish is a large predatory fish found in Antarctic waters, known for its sharp teeth and ability to survive extreme cold.', 'Legendary', 'Art/Sprites/Fish/157', 10.0, 50.0, 5, 1, 0),
('Emerald rockcod', 'The Emerald Rockcod is a bottom-dwelling predator found in deep-sea habitats, known for its vibrant greenish color and fierce predation.', 'Rare', 'Art/Sprites/Fish/158', 0.8, 3.0, 4, 1, 0),
('Bald notothen', 'The Bald Notothen is a fish found in cold Antarctic waters, known for its bald head and ability to adapt to extreme conditions.', 'Rare', 'Art/Sprites/Fish/159', 0.5, 2.0, 3, 1, 0),
('Spiny icefish', 'The Spiny Icefish is a unique fish found in the icy waters of the Antarctic, known for its sharp fins and transparent skin.', 'Rare', 'Art/Sprites/Fish/160', 0.5, 2.0, 3, 1, 0);
